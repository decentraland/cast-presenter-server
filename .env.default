# This file should be safe to commit and can act as documentation for all
# the possible configurations of our server.

# This file contains the default environment variables, by default,
# it is third in precedence:
#   1. process environment variables
#   2. `.env` file contents
#   3. `.env.default` file contents.

HTTP_SERVER_PORT=3000
HTTP_SERVER_HOST=0.0.0.0

# reset metrics at 00:00UTC
WKC_METRICS_RESET_AT_NIGHT=false

# Google Drive video proxy (public files only; no credentials required)
# REQUIRED: comma-separated list of allowed Drive file IDs (empty = deny all)
DRIVE_VIDEO_ALLOWED_FILE_IDS=
# Optional: CORS origin for /api/drive-video (e.g. https://your-frontend.com or * for any)
DRIVE_VIDEO_CORS_ORIGIN=

# Maximum number of concurrent presentations (0 = unlimited, default: 10)
MAX_CONCURRENT_PRESENTATIONS=10

# Client-side composition (cast v2) is the dapps-cast-client-composition feature flag, read when each session starts.
# Set FF_DAPPS_CAST_CLIENT_COMPOSITION=1 to force it on (any other value forces it off) without the feature-flags service.
# Public origin of this service (e.g. https://cast.example.com), used to build slide image URLs.
# Sessions fall back to server composition while it is unset; must be https:// (http:// only for localhost), with no credentials, query or fragment
PUBLIC_BASE_URL=
# Path of the cast-sidecar binary that publishes the v2 presentation-video and presentation-audio tracks
SIDECAR_BINARY_PATH=/usr/local/bin/cast-sidecar

# IMPORTANT: In production, this server MUST run behind a TLS-terminating reverse proxy
# (e.g. nginx, AWS ALB, Cloudflare) to protect LiveKit tokens in transit.
# The reverse proxy MUST also enforce a request body size limit (e.g. nginx client_max_body_size 110m)
# because the application buffers the full upload body into memory before validation.
