{
  "name": "cast-presenter-server",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --trace-warnings --abort-on-uncaught-exception --unhandled-rejections=strict dist/index.js",
    "lint": "eslint '{src,test}/**/*.{js,ts}'",
    "lint:fix": "eslint '{src,test}/**/*.{js,ts}' --fix",
    "start:dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "test": "jest --forceExit --detectOpenHandles --coverage --verbose",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check '{src,test}/**/*.{js,ts}'",
    "format:fix": "prettier --write '{src,test}/**/*.{js,ts}'",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx nano-staged",
    "pre-push": "yarn typecheck && yarn test --no-coverage"
  },
  "nano-staged": {
    "*.{js,ts}": [
      "eslint",
      "prettier --check"
    ]
  },
  "devDependencies": {
    "@dcl/eslint-config": "^2.3.1",
    "@types/busboy": "1.5.4",
    "@types/node": "^20.14.2",
    "@well-known-components/test-helpers": "^1.5.8",
    "eslint": "^8",
    "jest": "^30.2.0",
    "nano-staged": "^1.0.2",
    "nodemon": "^3.1.10",
    "simple-git-hooks": "^2.13.1",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "tabWidth": 2
  },
  "dependencies": {
    "@dcl/protocol": "1.0.0-23951495761.commit-bf007b9",
    "@dcl/traced-fetch-component": "^1.0.0",
    "@livekit/rtc-node": "^0.13.24",
    "@napi-rs/canvas": "^0.1.97",
    "@well-known-components/env-config-provider": "^1.2.0",
    "@well-known-components/fetch-component": "^3.0.0",
    "@well-known-components/http-requests-logger-component": "^2.1.0",
    "@well-known-components/http-server": "^2.1.0",
    "@well-known-components/http-tracer-component": "^1.1.0",
    "@well-known-components/interfaces": "^1.5.1",
    "@well-known-components/logger": "^3.1.3",
    "@well-known-components/metrics": "^2.1.0",
    "@well-known-components/tracer-component": "^1.2.0",
    "busboy": "^1.6.0",
    "fast-xml-parser": "5.7.0",
    "jszip": "3.10.1",
    "pdfjs-dist": "^4.7.76"
  }
}
